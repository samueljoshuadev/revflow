NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public sales contact used by the marketing pages. Digits only, including country code.
NEXT_PUBLIC_SALES_WHATSAPP_NUMBER=5511988407914

# Server-only. Add only when a trusted background job truly needs it.
# Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# 32 bytes encoded as base64 or 64 hexadecimal characters. Server-only.
# Generate once per environment and keep it stable; rotating it requires
# re-encrypting every stored provider credential.
INTEGRATION_ENCRYPTION_KEY=

# Optional AI qualification (server-only)
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional Google Calendar OAuth (server-only except public provider metadata)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional Calendly API/webhook
CALENDLY_ACCESS_TOKEN=
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=
CALENDLY_WEBHOOK_SIGNING_KEY=

# WhatsApp Business Platform — Meta Embedded Signup (server-only)
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_CONFIGURATION_ID=
META_WEBHOOK_VERIFY_TOKEN=
# Use a Graph API version currently supported by the Meta app, for example vXX.X.
META_GRAPH_API_VERSION=

# Follow-up worker and optional transactional email (server-only)
CRON_SECRET=
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=RevFlow <notificacoes@seu-dominio.com>

# Legacy/manual WhatsApp Cloud API setup (optional per organization)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Future webhook secrets (server-only)
CALENDLY_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_SECRET=
FORMS_WEBHOOK_SECRET=
META_WEBHOOK_SECRET=
N8N_WEBHOOK_SECRET=
